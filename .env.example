# AI Design Generator - Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control!

# =============================================================================
# API Keys (Required for image generation)
# =============================================================================
# Stability AI API Key - Get from: https://platform.stability.ai/
STABILITY_API_KEY=your_stability_api_key_here

# Hugging Face API Key - Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# =============================================================================
# Admin Configuration
# =============================================================================
# Comma-separated list of admin email addresses.
# Users with these emails will have isAdmin=true after authentication.
# Admin users can access: Template Creation, Client Management, Support Responses
# Example: "admin@example.com" or "admin1@example.com,admin2@example.com"
ADMIN_EMAILS="langtechgroup5@gmail.com"

# =============================================================================
# Admin Seed Script Configuration (Optional)
# =============================================================================
# Used by server/scripts/seedAdmin.js to create/update an admin account.
# IMPORTANT: Set ADMIN_SEED_PASSWORD via secrets management, NOT in this file!
# The password should be set at runtime through:
#   - CI/CD secrets
#   - Cloud provider secrets (AWS Secrets Manager, GCP Secret Manager, etc.)
#   - Environment variables in your deployment platform
ADMIN_EMAIL=langtechgroup5@gmail.com
# ADMIN_SEED_PASSWORD= (set via secrets, never commit!)

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000

# Set to '1' or 'true' to enable mock responses for testing
UNIT_TESTING=false
# Copy this file to .env and update the values for your deployment
#
# IMPORTANT: Never commit .env or any file containing actual credentials to version control

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================

# Admin Emails - Comma-separated list of email addresses that should have admin privileges
# These users will see the admin navigation links (Template Creation, Client Management, Support Responses)
# in addition to the standard client navigation.
#
# Example with single admin:
# ADMIN_EMAILS=langtechgroup5@gmail.com
#
# Example with multiple admins:
# ADMIN_EMAILS=admin1@example.com,admin2@example.com,langtechgroup5@gmail.com
#
# Leave empty or don't set for no admin configuration (users must have 'admin' or 'master' role in Firestore)
ADMIN_EMAILS=

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
#
# For Static Hosting (GitHub Pages, Netlify, Vercel):
# ---------------------------------------------------
# Since this is a client-side application, environment variables cannot be directly read.
# Instead, inject the admin configuration before loading the app:
#
# Option 1: Modify js/config/config.js for deployment (not recommended - don't commit secrets)
#
# Option 2: Inject via script tag before config.js loads (recommended)
#   Add this to your HTML before the config.js script:
#   <script>
#     window.ADMIN_EMAILS = ['langtechgroup5@gmail.com', 'admin2@example.com'];
#   </script>
#
# Option 3: Use server-side rendering or build-time injection
#   Configure your CI/CD pipeline to replace placeholders in config.js with actual values
#   during the build process.
#
# For Server-Side Deployment (Node.js, Express):
# ----------------------------------------------
# Use the ADMIN_EMAILS environment variable and inject it into the page:
#
#   const adminEmails = (process.env.ADMIN_EMAILS || '').split(',').map(e => e.trim()).filter(Boolean);
#   // Pass to your template rendering or inject into a script tag
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. Never commit actual admin email addresses to the repository
# 2. Use environment variables or secure secret management in production
# 3. The admin configuration only controls UI visibility - backend/Firestore rules
#    should also validate admin permissions for sensitive operations
# 4. Consider using Firebase Custom Claims for more secure admin role management
#
